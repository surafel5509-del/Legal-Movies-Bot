{
  "$schema": "https://railway.app/railway.schema.json",
  "build": { "builder": "RAILPACK", "buildCommand": "pip install -r requirements.txt" },
  "deploy": { "startCommand": "python -m bot.main", "healthcheckPath": "/health", "healthcheckTimeout": 30, "restartPolicyType": "ON_FAILURE", "restartPolicyMaxRetries": 10 }
}
