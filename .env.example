# Required Telegram bot token from @BotFather
BOT_TOKEN=replace_with_botfather_token

# Optional: comma-separated Telegram user IDs allowed to use /admin and /broadcast
ADMIN_IDS=

# PostgreSQL is recommended on Railway. SQLite is suitable for local development.
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# TMDB metadata, posters, trailers and official watch-provider links
TMDB_API_KEY=
TMDB_WATCH_REGION=US

# Enable/disable downloads from explicitly allowlisted open-license catalogs
ARCHIVE_CATALOG_ENABLED=true

# Operational limits
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=51380224
MAX_CONCURRENT_DOWNLOADS=2
ARCHIVE_PAGE_SIZE=10
CACHE_TTL_SECONDS=600
REQUEST_TIMEOUT_SECONDS=25
TEMP_DIR=/tmp/legal-movie-bot
