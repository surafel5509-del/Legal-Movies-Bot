# Required Telegram bot token from @BotFather
BOT_TOKEN=replace_with_botfather_token
ADMIN_IDS=
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# TMDB metadata, posters, trailers and official watch-provider links
TMDB_API_KEY=
TMDB_WATCH_REGION=ET

# Open-license catalog downloads
ARCHIVE_CATALOG_ENABLED=true

# TorrentClaw search (API key optional; anonymous tier is rate-limited)
TORRENTCLAW_API_KEY=

# IMPORTANT: only add info hashes after independently confirming rights/permission.
# Comma-separated 40-character SHA1 hashes. Empty means no TorrentClaw download buttons.
TORRENTCLAW_APPROVED_INFOHASHES=

LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=51380224
MAX_CONCURRENT_DOWNLOADS=2
ARCHIVE_PAGE_SIZE=10
CACHE_TTL_SECONDS=600
REQUEST_TIMEOUT_SECONDS=25
TEMP_DIR=/tmp/legal-movie-bot
